# Dotnet Rust Engine Environment Configuration
# Copy this file to .env and adjust variables as needed

# Base application data directory (defaults to %LOCALAPPDATA%\Dotnet if unset)
DOTNET_DATA_DIR=

# Logging level: trace, debug, info, warn, error
DOTNET_LOG_LEVEL=info

# Service orchestration profile: standalone | docker
DOTNET_PROFILE=standalone

# Port inspection and timeout in milliseconds
DOTNET_PORT_TIMEOUT_MS=1500

# Enable auto-start for boot services
DOTNET_AUTO_START=false

# FastCGI PHP worker pool size (1 - 8)
DOTNET_PHP_POOL_SIZE=2

# Developer mode (enables dry-run / sandbox guards against real system changes)
DOTNET_DEV_MODE=false
